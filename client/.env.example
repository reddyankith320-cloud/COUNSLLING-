# Razorpay (public key only - KEY_SECRET must NEVER go here)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Backend API origin. Leave EMPTY for local dev (Vite proxies /api to localhost:5000).
# In production set it to your API host, e.g. https://api.findmypeace.in
VITE_API_BASE_URL=

# Socket.io origin (defaults to VITE_API_BASE_URL when empty)
VITE_SOCKET_URL=
